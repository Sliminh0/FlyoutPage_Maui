<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app_hamburguer.NewPage1"
             Title="Calcula Page">
    <VerticalStackLayout>
        <ScrollView>
            <Label 
                Text="Preço do Etanol (R$)"
                FontSize="16" />
            <Entry
                x:Name="txtEtanol"
                Placeholder="Ex: 3.99"
                Keyboard="Numeric"
                />


            <Label 
                Text="Preço da Gasolina (R$)"
                FontSize="16" />
            <Entry
                x:Name="txtGas"
                Placeholder="Ex: 5.99"
                Keyboard="Numeric"
                />

            <Button Text="Calcular"
                    Clicked="OnCalcularClicked"
                    Margin="0, 10, 0, 0"/>

            <Button Text="Limpar"
                    Clicked="OnLimparClicked"
                    Margin="0, 10, 0, 0"/>


            <Label x:Name="lblResultado"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0, 20, 0, 0"
                   TextColor="DarkGreen"/>

        </ScrollView>
    </VerticalStackLayout>
</ContentPage>